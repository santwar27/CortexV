# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# Master key for the HTTP API (header: X-Cortex-Key)
CORTEX_API_KEY=change-me-to-a-long-random-string

# Ollama endpoint (default works for local install)
OLLAMA_HOST=http://localhost:11434

# Model names registered in Ollama
CORTEX_MODEL_ANALYTICAL=cortex-lite
CORTEX_MODEL_CREATIVE=cortex-criativo
CORTEX_MODEL_VISION=llava
CORTEX_MODEL_EMBED=nomic-embed-text

# How long (hours) the internet lease lasts when the user approves a search
CORTEX_LEASE_HOURS=4

# Web search backend: "tavily" (default, AI-optimized, free tier 1k/month)
# or "ddg" to force DuckDuckGo (no auth, unlimited but lower quality).
CORTEX_SEARCH_PROVIDER=tavily

# Optional search country (ISO alpha-2: GB, US, BR, PT, IE, CA); empty keeps provider defaults.
CORTEX_SEARCH_COUNTRY=

# Tavily API key — get from https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=tvly-dev-replace-with-your-token

# Spotify Web API — get from https://developer.spotify.com/dashboard
# Required scopes: playback-state, library-modify (Premium required for playback)
# Redirect URI registered in the dashboard: http://127.0.0.1:8765/callback
SPOTIFY_CLIENT_ID=replace-with-your-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-client-secret

# ---------------------------------------------------------------------
# Tuning knobs (all optional — defaults shown; uncomment to override)
# ---------------------------------------------------------------------

# Keep the Ollama model warm between queries ("30m"; "-1" = pinned forever,
# "5m" = Ollama's own default). s24 latency fix.
# CORTEX_KEEP_ALIVE=30m

# Sampling temperature for the conversational chat paths (anti-refusal low
# default; the creative engine uses its Modelfile temperature).
# CORTEX_CHAT_TEMPERATURE=0.3

# Staged-action TTL in minutes (M1-A9, s67): a "sim" to an action staged
# longer ago than this is discarded with a spoken notice instead of
# executing a forgotten email/event.
# CORTEX_PENDING_TTL_MIN=15

# Context budget (chars) reserved for [KNOWLEDGE] chunks ahead of
# conversation history in retrieval (M3-A2, s64).
# CORTEX_CTX_KNOWLEDGE_BUDGET=900

# TTS engine: unset = auto (Piper if both voice models exist, else `say`).
# CORTEX_TTS=piper

# Wake word model + threshold (s24; unset = bundled hey_cortex / 0.35).
# CORTEX_WAKE_THRESHOLD=0.35

# Dormant feature flags (Mac Studio day — see the quick reference in
# docs/operations/mac_studio_runbook.md; ALL default-off by design):
# CORTEX_DEEP_STUDIER / CORTEX_DREAM_LOOP / CORTEX_COUNCIL /
# CORTEX_ARBITER_CASCADE / CORTEX_PROMPT_VERSION=frontier /
# CORTEX_PLANNER_EXTRACTION

# IP allowlist (defence-in-depth over Tailscale ACLs)
# Comma-separated list of IPs / CIDRs allowed to reach the API.
# When EMPTY (default) all IPs are allowed — same as before this feature.
# Typical hardened value: the Tailscale CGNAT range + localhost for dev.
# IPv6 also supported (Tailscale ULA range is fd7a:115c:a1e0::/48).
# See docs/operations/tailscale_lockdown.md for the matching Tailscale
# admin-side config.
CORTEX_IP_ALLOWLIST=
# CORTEX_IP_ALLOWLIST=100.64.0.0/10, 127.0.0.1, fd7a:115c:a1e0::/48

# Reply caps on every engine call; invalid/non-positive values use these defaults.
CORTEX_NUM_PREDICT=2048
CORTEX_CODE_NUM_PREDICT=3000
# Both Modelfiles use 8192. This overrides prompt budgeting only; keep it aligned.
CORTEX_NUM_CTX=8192
